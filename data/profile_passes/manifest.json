{
  "_doc": "Profile + measurement pass orchestration. Run gaps → fanout → apply → rebuild.",
  "optimization_ladder": [
    {"priority": "P0", "pass": "sfcr_mining", "why": "Disclosed GWP on gate cohort — moves L5 gate toward 60%"},
    {"priority": "P0", "pass": "entity_analysis", "why": "L3 grid posture + cover stack on click (31/31 after batch4)"},
    {"priority": "P1", "pass": "placements", "why": "Product chips from KG — placement_mapper / generate_portfolio"},
    {"priority": "P1", "pass": "book_mining", "why": "Lloyd's iXBRL class GWP for book_concentration measured tier"},
    {"priority": "P2", "pass": "register_pull", "why": "Live ECR/TEC for non_firm_intensity measured tier"},
    {"priority": "P2", "pass": "capital_mining", "why": "Disclosed SCR/FSR for capital_reinsurance"},
    {"priority": "P3", "pass": "audit", "why": "data_steward source/tier QA at scale"}
  ],
  "workflow": [
    "python3 harness/data_orchestrator.py status",
    "python3 harness/data_orchestrator.py fanout",
    "Deploy N parallel subagents (bot_deploy.py --prompt …)",
    "python3 harness/data_orchestrator.py apply all",
    "python3 harness/data_orchestrator.py cycle [--measure]",
    "python3 harness/data_orchestrator.py report"
  ],
  "continuous_cycle": {
    "_doc": "Repeat weekly or after register refresh. See DATA_ORCHESTRATION.md §8.",
    "phases": [
      {"id": "discover", "cmd": "data_orchestrator.py status && data_orchestrator.py next"},
      {"id": "fanout", "cmd": "data_orchestrator.py fanout", "then": "bot_deploy.py --prompt <pass> <batch>"},
      {"id": "merge", "cmd": "data_orchestrator.py apply all"},
      {"id": "measure", "cmd": "data_orchestrator.py cycle --measure", "optional": true},
      {"id": "verify", "cmd": "run_loop.py --check"},
      {"id": "report", "cmd": "data_orchestrator.py report", "writes": "data/expansion_status.json"}
    ],
    "expand_universe": "data_orchestrator.py expand data/<new_entities>.json",
    "publish_path": "publish_pipeline.py rebuild",
    "gate_target": 0.60,
    "gate_metric": "authoritative_share on full universe (records.json + measured overlay)"
  },
