{
  "version": "0.1",
  "title": "CMUI Risk Model — latent × deterministic fusion",
  "summary": "Compute Market Underwriting Index. Each sub-factor carries latent (research) and deterministic (index/filing) ratings. Published axis scores are credibility-weighted blends — never LLM outputs. Citations: contract/compute_citations.json; grid bridge: contract/citations.json (NFRI).",
  "model_spec": "contract/COMPUTE_MODEL_SPEC.md",
  "citations_registry": "contract/compute_citations.json",
  "nfri_citations_registry": "contract/citations.json",
  "fusion": {
    "description": "Credibility-weighted blend of deterministic (index/filing) and latent (research) ratings per sub-factor.",
    "formula": "r_eff = clamp(0,4, λ·r_det + (1−λ)·r_lat)",
    "formula_latex": "r_{\\mathrm{eff}} = \\mathrm{clamp}_{[0,4]}\\bigl(\\lambda r_{\\mathrm{det}} + (1-\\lambda) r_{\\mathrm{lat}}\\bigr)",
    "citation_ids": ["ACT-CREDIBILITY"],
    "lambda_formula": "λ = max(0, λ_tier + δ_confidence)",
    "lambda_by_tier": {
      "measured": {"value": 0.95, "citation_ids": ["ACT-CREDIBILITY", "ST-H100-INDEX", "ST-TIGHTNESS-INDEX"]},
      "derived": {"value": 0.85, "citation_ids": ["ACT-CREDIBILITY", "ST-FORWARD-CURVE"]},
      "disclosed": {"value": 0.80, "citation_ids": ["ACT-CREDIBILITY", "IND-GPU-ABS"]},
      "assessed": {"value": 0.0, "citation_ids": ["ACT-CREDIBILITY"]},
      "unknown": {"value": 0.0, "citation_ids": ["ACT-CREDIBILITY"]}
    },
    "confidence_adjustment": {
      "high": 0.0,
      "medium": -0.05,
      "low": -0.10,
      "citation_ids": ["ACT-CREDIBILITY"],
      "note": "Lower confidence in deterministic input reduces λ toward latent prior."
    }
  },
  "axis_formulas": {
    "exposure": {
      "symbol": "E",
      "formula": "E = (Σ w_i · r_eff_i / 4) × 100",
      "citation_ids": ["ACT-COMP-LOSS", "ST-H100-VOLATILITY"],
      "range": [0, 100],
      "interpretation": "Gross exposure to compute-market loss — unhedged GPU-hour spend, capacity shortfall, basis mismatch, economic-life uncertainty — before insurance and derivatives mitigation.",
      "sub_factors": {
        "capacity_at_risk": {
          "weight": 0.22,
          "citation_ids": ["ST-H100-PERP", "ST-OPEN-WEIGHTS-RISK"],
          "layer_note": "L3: unhedged GPU-hour notional normalized. L1/L2/L4: GWP compute/parametric share.",
          "deterministic": {
            "formula_l3": "n_norm = min(1, H_annual × (1 − H_hedged/H_annual) / N_ref), N_ref = 1e7 GPU-hours/year",
            "formula_l1_l2": "c_book = GWP_compute_parametric / GWP_total",
            "rating": "threshold_map(n_norm or c_book, capacity_at_risk_thresholds)",
            "citation_ids": ["ST-H100-PERP", "IND-GPU-SWAP"]
          },
          "latent": {
            "method": "Research on undisclosed procurement (burn × implied cluster size)",
            "citation_ids": ["ST-OPEN-WEIGHTS-RISK"]
          }
        },
        "tightness_sensitivity": {
          "weight": 0.20,
          "citation_ids": ["ST-H100-VOLATILITY", "ST-OPEN-WEIGHTS-RISK", "ST-TIGHTNESS-INDEX"],
          "deterministic": {
            "formula": "β_T = σ_30(TightnessIndex) × f_short, f_short = (H_on_demand + H_spot + H_<90d) / H_annual",
            "rating": "threshold_map(β_T, tightness_sensitivity_thresholds)",
            "citation_ids": ["ST-TIGHTNESS-INDEX", "ST-H100-VOLATILITY"]
          },
          "latent": {
            "method": "Workload burstiness when contract shape undisclosed",
            "citation_ids": ["ST-H100-VOLATILITY"]
          }
        },
        "price_basis_gap": {
          "weight": 0.16,
          "citation_ids": ["ACAD-BASIS-RISK-ARXIV", "ACAD-BASIS-RISK-EXPECTILES", "ST-H100-VOLATILITY"],
          "deterministic": {
            "formula": "g_basis = |ln(r_contract / r_index)|",
            "rating": "threshold_map(g_basis, price_basis_gap_thresholds)",
            "citation_ids": ["ACAD-BASIS-RISK-ARXIV", "ST-H100-INDEX"]
          },
          "latent": {
            "method": "Product wording vs index class mismatch from broker terms",
            "citation_ids": ["ACAD-BASIS-RISK-EXPECTILES"]
          }
        },
        "price_volatility_exposure": {
          "weight": 0.14,
          "citation_ids": ["ST-H100-VOLATILITY", "ST-GPU-DEPRECIATION"],
          "deterministic": {
            "formula": "v = p_unhedged × σ_90(r_spot) / mean(r_spot)",
            "rating": "threshold_map(v, price_volatility_exposure_thresholds)",
            "citation_ids": ["ST-H100-INDEX", "ST-H100-VOLATILITY"]
          },
          "latent": {
            "method": "Budget exposure when index history unavailable",
            "citation_ids": ["ST-H100-VOLATILITY"]
          }
        },
        "shock_calendar_exposure": {
          "weight": 0.10,
          "citation_ids": ["ST-OPEN-WEIGHTS-RISK"],
          "deterministic": {
            "formula": "s_ow = w_finetune + w_post_train + 1_open_weights_in_prod",
            "rating": "threshold_map(s_ow, shock_calendar_exposure_thresholds)",
            "citation_ids": ["ST-OPEN-WEIGHTS-RISK"]
          },
          "latent": {
            "method": "Public statements on in-house RL/post-training on open weights",
            "citation_ids": ["ST-OPEN-WEIGHTS-RISK"]
          }
        },
        "depreciation_tenor_mismatch": {
          "weight": 0.10,
          "citation_ids": ["ST-GPU-DEPRECIATION", "IND-GPU-ABS", "IND-GPU-FORWARD-CURVE"],
          "deterministic": {
            "formula": "m_tenor = max(0, (T_account − T_econ_implied) / 6yr), T_econ from F_12m/F_0 < θ_obs (0.50)",
            "rating": "threshold_map(m_tenor, depreciation_tenor_mismatch_thresholds)",
            "citation_ids": ["ST-FORWARD-CURVE", "ST-GPU-DEPRECIATION"]
          },
          "latent": {
            "method": "Disclosed accounting life vs market commentary on fleet refresh",
            "citation_ids": ["ST-GPU-DEPRECIATION"]
          }
        },
        "grid_compute_coupling": {
          "weight": 0.08,
          "citation_ids": ["CMUI-NFRI-BRIDGE", "INDUSTRY-DC-COMPUTE-DEMAND", "ACAD-CCM-NF-LOAD"],
          "deterministic": {
            "formula": "I_grid = load_norm(import_MW) × s_NF × p_curtail(boundary) — NFRI non_firm_compute_exposure",
            "rating": "threshold_map(I_grid, grid_compute_coupling_index)",
            "citation_ids": ["CMUI-NFRI-BRIDGE", "ACAD-CCM-NF-LOAD"]
          },
          "latent": {
            "method": "Assessed when no NFRI L3 link; capped medium confidence",
            "citation_ids": ["INDUSTRY-DC-COMPUTE-DEMAND"]
          }
        }
      }
    },
    "preparedness": {
      "symbol": "P",
