            "citation_ids": ["FCA-PRIN"]
          },
          "latent": {
            "method": "Named compute-finance + insurance specialist teams",
            "citation_ids": ["BROK-MARSH-NIMBUS"]
          }
        },
        "capital_reinsurance": {
          "weight": 0.10,
          "citation_ids": ["PRA-SII-SCR", "RATING-AMBEST-FSR", "IND-GPU-ABS"],
          "deterministic": {
            "formula": "rating = lookup(FSR) or lookup(SCR_coverage_pct) + gpu_abs_bump",
            "citation_ids": ["RATING-AMBEST-FSR", "PRA-SII-SCR", "IND-GPU-ABS"]
          },
          "latent": {
            "method": "Capacity depth when ratings undisclosed",
            "citation_ids": ["IND-GPU-ABS"]
          }
        }
      }
    },
    "margin_of_safety": {
      "symbol": "MoS",
      "formula": "MoS = P − E",
      "citation_ids": ["ACT-CREDIBILITY", "PRA-SII-SCR"],
      "range": [-100, 100],
      "interpretation": "Surplus of preparedness over exposure — negative MoS flags compute underwriting deficit.",
      "quadrant_rule": {
