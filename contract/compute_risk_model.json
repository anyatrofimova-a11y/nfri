          "deterministic": {
            "formula": "E[L] = P(event) × E[S|event] with forward curve + survival or full V_0 model",
            "rating": "lookup(pricing_modelling_tier_map)",
            "citation_ids": ["ST-GPU-DEPRECIATION", "ACT-COMP-LOSS"]
          },
          "latent": {
