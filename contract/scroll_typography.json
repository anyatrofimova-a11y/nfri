{
  "_doc": "Locked scroll + long-form typography surface. Reference: a16z Building American Dynamism (smooth scroll, stable gutter, serif essay body, sans chrome). Mapped to open fonts in contract/design_system.json — no Typekit.",
  "version": "0.1",
  "as_of": "2026-06-27",
  "reference": {
    "url": "https://a16z.com/building-american-dynamism/",
    "editorial": "https://www.felixstocker.com",
    "fonts_proprietary": "freight-text-pro (display), adobe-caslon-pro (body/nav)",
    "fonts_open_map": {
      "display": "Newsreader",
      "essay_body": "Libre Caslon Text",
      "nav": "Libre Caslon Text",
      "ui": "IBM Plex Sans",
      "meta": "IBM Plex Mono"
    }
  },
  "scroll": {
    "behavior": "smooth",
    "padding_top": "var(--sticky-offset)",
    "scrollbar_gutter": "stable",
    "overscroll": "none",
    "anchor_offset_rule": "scroll-padding-top on html + scroll-margin-top on sections"
  },
  "essay_surface": {
    "measure": "52rem",
    "body_size": "1.2rem",
    "body_leading": 1.8,
    "paragraph_gap": "1.35em",
    "pull_size": "1.3125rem",
    "pull_leading": 1.55,
    "heading_tracking": "0",
    "reveal": {
      "translate_y": "18px",
      "duration": "0.72s",
      "threshold": 0.08
    }
  },
  "verify": {
    "css_markers": [
      "scroll-behavior:smooth",
      "scroll-padding-top:var(--sticky-offset)",
      "scrollbar-gutter:stable",
      "--font-essay",
      "--type-essay-body"
    ],
    "classes": ["essay-reveal"]
  }
}
