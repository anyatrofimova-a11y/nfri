            "citation_ids": ["MGA-PARAMETRIX-ANALYTICS"]
          },
          "latent": {
            "method": "Assessed from cited monitoring platforms; capped medium without external verification",
            "citation_ids": ["MGA-PARAMETRIX-ANALYTICS", "BROK-LOCKTON-SLA"]
          }
        },
        "product_fit": {
          "weight": 0.20,
          "citation_ids": ["LLOYDS-PARAMETRIC-CYBER", "BROK-LOCKTON-SLA", "BROK-MARSH-NIMBUS", "INSTECH-NDBI-PARAMETRIC", "DESCARTES-DC-PARAMETRIC", "MUNICHRE-GENAI-WP", "MARSH-NIMBUS-UK-LAUNCH", "INDUSTRY-PARAMETRIC-DC-FINANCING"],
          "deterministic": {
