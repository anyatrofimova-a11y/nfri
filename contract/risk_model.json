          "citation_ids": ["MGA-PARAMETRIX-ANALYTICS", "ACT-CREDIBILITY", "MGA-PARAMETRIX-SLA", "MUNICHRE-GENAI-WP", "REG-IAIS-PARAMETRIC"],
          "deterministic": {
