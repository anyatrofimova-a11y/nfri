          }
        }
      }
    },
    "margin_of_safety": {
      "symbol": "MoS",
      "formula": "MoS = P − E",
      "citation_ids": ["ACT-CREDIBILITY", "PRA-SII-SCR"],
      "range": [-100, 100],
      "interpretation": "Surplus of preparedness over exposure — negative MoS flags capital/underwriting deficit relative to non-firm book.",
      "quadrant_rule": {
