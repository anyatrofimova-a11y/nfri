{
  "version": "0.2",
  "title": "NFRI Risk Model — latent × deterministic fusion",
  "summary": "Each sub-factor carries a latent (research) rating and, where registers permit, a deterministic rating. The published axis score is a tier-weighted fusion (credibility-weighted blend), never an LLM output. Every formula cites contract/citations.json.",
  "model_spec": "contract/MODEL_SPEC.md",
  "citations_registry": "contract/citations.json",
  "fusion": {
    "description": "Credibility-weighted blend of deterministic (register/filing) and latent (research) ratings per sub-factor.",
    "formula": "r_eff = clamp(0,4, λ·r_det + (1−λ)·r_lat)",
    "formula_latex": "r_{\\mathrm{eff}} = \\mathrm{clamp}_{[0,4]}\\bigl(\\lambda r_{\\mathrm{det}} + (1-\\lambda) r_{\\mathrm{lat}}\\bigr)",
    "citation_ids": ["ACT-CREDIBILITY"],
    "lambda_formula": "λ = max(0, λ_tier + δ_confidence)",
    "lambda_by_tier": {
      "measured": {"value": 0.95, "citation_ids": ["ACT-CREDIBILITY", "NESO-TEC", "NGED-ECR"]},
      "derived": {"value": 0.85, "citation_ids": ["ACT-CREDIBILITY", "ACT-HHI-EIOPA"]},
      "disclosed": {"value": 0.80, "citation_ids": ["ACT-CREDIBILITY", "PRA-SII-SCR", "RATING-AMBEST-FSR"]},
      "assessed": {"value": 0.0, "citation_ids": ["ACT-CREDIBILITY"]},
      "unknown": {"value": 0.0, "citation_ids": ["ACT-CREDIBILITY"]}
    },
    "confidence_adjustment": {
      "high": 0.0,
      "medium": -0.05,
      "low": -0.10,
      "citation_ids": ["ACT-CREDIBILITY"],
      "note": "Lower confidence in deterministic input reduces λ toward latent prior."
    }
  },
  "axis_formulas": {
    "exposure": {
      "symbol": "E",
      "formula": "E = (Σ w_i · r_eff_i / 4) × 100",
      "citation_ids": ["ACT-COMP-LOSS", "LLOYDS-RDS"],
      "range": [0, 100],
      "interpretation": "Gross exposure to non-firm power risk before underwriting mitigation — analogous to undiversified loss potential in a compound model.",
      "sub_factors": {
        "book_concentration": {
          "weight": 0.30,
          "citation_ids": ["PRA-PPP", "SII-DELEG-35", "UK-GOV-SII-REFORM", "ACAD-AI-ENERGY-DCC", "EPIC-DC-ENERGY-RISK"],
          "deterministic": {
            "formula": "c_book = GWP_energy_dc / GWP_total",
            "rating": "anchor_0_4(c_book) from rubric.json",
            "citation_ids": ["PRA-SII-SCR", "SII-DELEG-35"]
          },
          "latent": {
            "method": "Research agent maps segment disclosures to rubric anchors",
            "citation_ids": ["PRA-PPP", "FCA-PRIN"]
          }
        },
        "non_firm_intensity": {
          "weight": 0.25,
          "citation_ids": ["NESO-CMP434", "NESO-CMP448", "DCUSA-ECR", "NESO-TEC", "ACAD-CRI-GRID-SRI", "EPIC-DC-ENERGY-RISK", "ACAD-CCM-NF-LOAD"],
          "layer_note": "At L3, replaced by non_firm_compute_exposure when derived tier present.",
          "deterministic": {
            "formula": "s_NF = Σ MW_nonfirm / Σ MW_total",
            "fields": "ECR flexible_connection flag; TEC Gate column (Gate 1 / Gate 2 / firm)",
            "rating": "threshold_map(s_NF, non_firm_intensity_from_share)",
            "citation_ids": ["NESO-TEC", "NGED-ECR", "NPG-ECR", "NESO-CMP434"]
          },
          "latent": {
            "method": "Research when register entity-resolution fails; carriers receive propagated interaction via asset_link",
            "citation_ids": ["NESO-CMP434", "ACAD-DC-OUTAGE"]
          }
        },
        "non_firm_compute_exposure": {
          "weight": 0.25,
          "include_layers": [3],
          "replaces": "non_firm_intensity",
          "citation_ids": ["ACAD-CCM-NF-LOAD", "NESO-CONSTRAINT-COSTS", "INDUSTRY-DC-COMPUTE-DEMAND", "NESO-TEC", "DCUSA-ECR"],
          "deterministic": {
            "formula": "I = load_norm(import_MW) × s_NF × p_curtail(boundary)",
            "load_norm": "min(1, import_MW / 500)",
            "curtailment_prob": "constraint_boundary.json → curtailment_prob_norm by GSP/boundary",
            "rating": "threshold_map(I, non_firm_compute_exposure_index)",
            "citation_ids": ["ACAD-CCM-NF-LOAD", "NESO-CONSTRAINT-COSTS", "INDUSTRY-DC-COMPUTE-DEMAND"]
          },
          "latent": {
            "method": "Not used at L3 when register-derived interaction is available",
            "citation_ids": ["ACAD-CCM-NF-LOAD"]
          }
        },
        "aggregation_correlation": {
          "weight": 0.20,
          "citation_ids": ["ACT-HHI-EIOPA", "ACT-HHI-CAS", "LLOYDS-RDS", "ACAD-AI-ENERGY-DCC", "ACAD-CRI-GRID-SRI"],
          "deterministic": {
            "formula": "HHI = Σ_z (MW_z / MW_total)²",
            "rating": "threshold_map(HHI, hhi_to_aggregation_rating)",
            "citation_ids": ["ACT-HHI-EIOPA", "ACT-HHI-CAS", "LLOYDS-RDS"]
          },
          "latent": {
            "method": "Regional clustering from disclosed geography + broker market commentary",
            "citation_ids": ["LLOYDS-RDS", "BROK-MARSH-NIMBUS"]
          }
        },
        "trigger_gap": {
          "weight": 0.15,
          "citation_ids": ["ACAD-BASIS-RISK-EXPECTILES", "ACAD-BASIS-RISK-ARXIV", "LMA-BI-GUIDE", "LLOYDS-PARAMETRIC-CYBER", "INSTECH-NDBI-PARAMETRIC", "MGA-PARAMETRIX-SLA", "DESCARTES-DC-PARAMETRIC", "INDUSTRY-PARAMETRIC-DC-FINANCING", "REG-IAIS-PARAMETRIC"],
          "deterministic": {
            "formula": "basis_gap = 1 − (availability_or_parametric_cover / relevant_cover)",
            "rating": "anchor_0_4(basis_gap)",
            "citation_ids": ["ACAD-BASIS-RISK-ARXIV", "LMA-BI-GUIDE"]
          },
          "latent": {
            "method": "Product wording analysis from filings / broker facility terms",
            "citation_ids": ["LMA-BI-GUIDE", "BROK-LOCKTON-SLA", "LLOYDS-PARAMETRIC-CYBER"]
          }
        },
        "tenor_mismatch": {
          "weight": 0.10,
          "citation_ids": ["ACT-COMP-LOSS", "UK-GOV-SII-REFORM"],
          "deterministic": {
            "formula": "m = max(0, T_policy − H_claims) / 15",
            "rating": "anchor_0_4(m)",
            "citation_ids": ["ACT-COMP-LOSS", "UK-GOV-SII-REFORM"]
          },
          "latent": {
            "method": "Disclosed facility tenor vs available loss experience",
            "citation_ids": ["BROK-MARSH-NIMBUS", "ACT-COMP-LOSS"]
          }
        }
      }
    },
    "preparedness": {
      "symbol": "P",
      "formula": "P = (Σ w_i · r_eff_i / 4) × 100",
      "citation_ids": ["PRA-SII-SCR", "LLOYDS-RDS", "ACT-CREDIBILITY"],
      "range": [0, 100],
      "interpretation": "Risk-adjusted underwriting capability — capital, products, data and modelling to carry non-firm exposure.",
      "sub_factors": {
        "data_monitoring": {
