          }
        },
        "capital_reinsurance": {
          "weight": 0.20,
          "citation_ids": ["PRA-SII-SCR", "RATING-AMBEST-FSR", "SII-DELEG-35", "LLOYDS-RDS", "MUNICHRE-GENAI-WP"],
          "deterministic": {
