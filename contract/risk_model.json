          "citation_ids": ["ACT-COMP-LOSS", "ACAD-BASIS-RISK-EXPECTILES", "ACAD-CRI-GRID-SRI", "MGA-PARAMETRIX-SLA", "DESCARTES-DC-PARAMETRIC", "MUNICHRE-GENAI-WP", "INSTECH-NDBI-PARAMETRIC"],
          "deterministic": {
            "formula": "E[loss] = P(curtailment) × E[SLA_breach_cost] when model published",
